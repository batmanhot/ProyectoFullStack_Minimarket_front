{
  "name": "minimarket",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "build:pwa": "vite build && node scripts/post-build.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "e2e:install": "node scripts/run-playwright.mjs install chromium",
    "e2e:reset": "npm --prefix ../../back/minimarket-api run e2e:reset",
    "pretest:e2e": "npm run e2e:reset",
    "test:e2e": "node scripts/run-playwright.mjs test",
    "test:e2e:ui": "node scripts/run-playwright.mjs test --ui"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@hookform/resolvers": "^5.2.2",
    "axios": "^1.20.0",
    "decimal.js": "^10.6.0",
    "dompurify": "^3.4.16",
    "html2canvas": "^1.4.1",
    "jsbarcode": "^3.12.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.564.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.1",
    "react-hot-toast": "^2.6.0",
    "react-is": "^19.2.6",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.8.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
