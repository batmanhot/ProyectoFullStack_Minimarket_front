# ─── Backend API ──────────────────────────────────────────────────────────────
# development | demo | production. En producción se oculta el acceso rápido.
VITE_APP_MODE=development

# URL del backend Fastify local.
VITE_API_URL=http://localhost:3001/api

# Activar conexión real al backend.
VITE_USE_API=true

# Solo para desarrollo/demo; no definir en producción.
VITE_DEMO_ADMIN_USER=
VITE_DEMO_ADMIN_PASSWORD=
VITE_DEMO_MANAGER_USER=
VITE_DEMO_MANAGER_PASSWORD=
VITE_DEMO_CASHIER_USER=
VITE_DEMO_CASHIER_PASSWORD=
VITE_DEMO_SUPERVISOR_PASSWORD=

# ─── Datos del negocio (opcionales, sobreescriben los defaults) ────────────────
# VITE_COMPANY_NAME=Mi Negocio
# VITE_COMPANY_RUC=20000000000
# VITE_COMPANY_ADDRESS=Av. Principal 123
# VITE_COMPANY_PHONE=01-000-0000
